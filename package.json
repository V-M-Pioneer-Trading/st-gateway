{
  "name": "st-gateway",
  "version": "1.0.0",
  "description": "Global SpaceTraders request gateway: one shared rate budget, injected SpaceTraders credential, centralized retry and identity-derived priority for all services",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "express": "^4.21.2",
    "jose": "^5.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  }
}
